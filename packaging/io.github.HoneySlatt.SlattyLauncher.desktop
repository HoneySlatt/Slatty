[Desktop Entry]
Type=Application
Name=SlattyLauncher
GenericName=Game launcher
Comment=Install and play your GOG games, beside your Steam games and your own
Exec=slatty-gui
Icon=io.github.HoneySlatt.SlattyLauncher
Terminal=false
Categories=Game;
Keywords=GOG;Galaxy;Steam;Proton;games;launcher;gamepad;Steam Deck;
StartupNotify=true
Actions=couch;

[Desktop Action couch]
Name=Couch mode
Exec=slatty-gui --couch
